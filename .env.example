# LOCAL DEVELOPMENT ONLY. Copy to .env; never commit credentials.
AUTH_MODE=local
HOST=127.0.0.1
PORT=4310
PUBLIC_URL=http://localhost:4310
DATABASE_PATH=./data/meetings.sqlite

# CUSTOMER DEPLOYMENT: customer-hosted application with SharePoint persistence.
# STORAGE_BACKEND=sharepoint
# SHAREPOINT_SITE_ID=
# SHAREPOINT_LIST_ID=
# SHAREPOINT_DRIVE_ID=
# DEFAULT_LANGUAGE=de
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_AUDIENCE=CLIENT_ID
# ENTRA_CLIENT_SECRET=

# Customer-controlled JSON chat-completions endpoint (no fixed provider).
# AI_COMPLETIONS_URL=https://CUSTOMER_AI_ENDPOINT/v1/chat/completions
# AI_MODEL=CUSTOMER_MODEL_DEPLOYMENT
# AI_API_KEY=
# AI_AUTH_HEADER=authorization
# For Azure deployment endpoints: AI_AUTH_HEADER=api-key

# Customer roleALPHA ra-meetings service, Streamable HTTP.
# ROLEALPHA_MCP_URL=https://CUSTOMER_ROLEALPHA_MEETINGS/mcp
# ROLEALPHA_TENANT_UUID=
# ROLEALPHA_MCP_TOKEN=

# Default: user explicitly starts analysis. Power Automate is NOT required.
AUTO_ANALYZE_TRANSCRIPTS=false
# Optional per-type MCP routes; use tools verified against the CUSTOMER service.
# ROLEALPHA_ENTITY_ROUTES={"risk":{"url":"https://CUSTOMER_RISK_SERVICE/mcp","tool":"create_risk","label":"Risiko"}}
# Other supported result types: okr, it_system, project, governance, policy, task, metric, checklist, note.
# No guessed default tools for these types. Each requires an explicit compatible route.
