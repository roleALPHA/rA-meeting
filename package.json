{
  "name": "@rolealpha/meeting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4310 --strictPort",
    "build": "npm run check && npm run spfx:build",
    "check": "tsc --noEmit && npm run format:check",
    "format": "prettier --write client shared scripts tests spfx/src vite.config.ts",
    "format:check": "prettier --check client shared scripts tests spfx/src vite.config.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "spfx:build": "node --import tsx scripts/build-browser.ts && node scripts/package-spfx.mjs",
    "spfx:install": "npm ci --prefix spfx --cache .npm-cache --no-audit --no-fund"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/hashes": "^2.4.0",
    "lucide-react": "^0.453.0",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "17.0.89",
    "@types/react-dom": "17.0.26",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.1",
    "prettier": "3.9.7",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.5"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
